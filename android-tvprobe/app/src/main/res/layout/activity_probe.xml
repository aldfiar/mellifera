<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Control panel: hide it and the video owns the screen; OK brings it back -->
    <ScrollView
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mellifera T0 probe — paste a full play URL into a row, focus its button, press OK"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/url_hevc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Probe 1: HEVC pack HLS"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <Button
                android:id="@+id/play_hevc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAY 1: HEVC pack HLS" />

            <EditText
                android:id="@+id/url_mkv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Probe 2: MKV original (direct floor)"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <Button
                android:id="@+id/play_mkv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAY 2: MKV original" />

            <EditText
                android:id="@+id/url_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Probe 3: translated multi-EXT-X-MAP HLS"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <Button
                android:id="@+id/play_map"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAY 3: translated EXT-X-MAP" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STOP" />

                <Button
                    android:id="@+id/hide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIDE (OK shows)" />

                <Button
                    android:id="@+id/cycle_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CYCLE AUDIO" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Always visible: device line at startup, player state + errors afterwards -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="#FFCC00"
        android:textSize="12sp" />
</FrameLayout>
