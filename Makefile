# Mellifera build targets. Pure-Go: CGO is disabled everywhere so the
# result is a single static binary with no C-toolchain dependency.
# See .claude/skills/mellifera-build/SKILL.md for the build gate.

.PHONY: proto build test lint check build-plugin web-build dev

# proto: regenerate gRPC bindings from the .proto definitions (requires
# protoc + protoc-gen-go/protoc-gen-go-grpc, or buf). Generated *.pb.go are
# committed; this target is only needed to regenerate.
proto:
	buf generate

# build: compile every Mellifera Go package (pure-Go, no CGO).
build:
	CGO_ENABLED=0 go build ./...

# test: run the table-driven test suite.
test:
	CGO_ENABLED=0 go test ./...

# lint: the complexity/quality budget (golangci-lint).
lint:
	golangci-lint run ./...

# check: the Mellifera build gate (lint + exported-symbol count per package).
check:
	bash .claude/skills/mellifera-build/scripts/check.sh

# Runtime deps (operators install these; they are NOT Go module deps and are
# NOT required at build time): ffmpeg/ffprobe (video probe — base-scanner) and
# exiftool (image EXIF — image-enricher). exiftool: `brew install exiftool`
# (macOS) / `apt install libimage-exiftool-perl` (Debian). A missing exiftool
# is a per-source SOFT-FAIL at enrichment, not a startup/build failure.
# See docs/architecture.md §1.2 (runtime deps) + the operator runbook.
# build-plugin: build every plugin binary. base-scanner is wired in T08;
# tv-parser (the first metadata_source plugin) in T06; image-enricher (EXIF
# via the system exiftool subprocess) in B2/Task 06; the serial trio
# (serial-scanner, serial-parser, frame-grabber) in serials-library — the
# registry seeds all six, so a fresh-checkout `go test .` (whose startServer
# harness launches the default bin/ paths) needs all six built here.
build-plugin:
	CGO_ENABLED=0 go build -o bin/base-scanner ./plugins/base-scanner
	CGO_ENABLED=0 go build -o bin/tv-parser ./plugins/tv-parser
	CGO_ENABLED=0 go build -o bin/image-enricher ./plugins/image-enricher
	CGO_ENABLED=0 go build -o bin/serial-scanner ./plugins/serial-scanner
	CGO_ENABLED=0 go build -o bin/serial-parser ./plugins/serial-parser
	CGO_ENABLED=0 go build -o bin/frame-grabber ./plugins/frame-grabber

# web-build: regenerate the embedded web artifacts (OpenAPI spec + the React
# SPA build). DEV/CI-ONLY — the same kind of regen step as `proto` (buf) and
# `build-plugin`: it relies on dev tools (swag CLI; node/npm) that are NOT Go
# module deps and are NOT required by the Go build gate.
#
# Resolved paths (Phase 2a): the npm project root is `web/` (package.json,
# vite.config.ts live there); Vite's build.outDir is `../internal/web/dist`
# (the `//go:embed all:dist` target at internal/web/web.go:20). So `cd web &&
# npm run build` emits the hashed SPA bundle directly into the committed
# internal/web/dist/. NEVER `cd internal/web` — that is not the npm root.
# `/web/dist/` is gitignored and unused; internal/web/dist/ is COMMITTED
# (the embed INPUT, like a committed *.pb.go).
#
# Build-gate story (AC-6): `build`/`check`/`lint`/`test` NEVER invoke
# node/npm/swag. They embed the COMMITTED artifacts under internal/web/
# (dist/* + api/openapi.{json,yaml}); the Apache-2.0 Swagger UI is embedded via
# the github.com/swaggo/http-swagger Go module, not a vendored tree. The
# committed output is what the Go gate compiles. `web-build` is the ONLY target
# that touches the swag/js toolchain — run it after editing swag annotations
# (internal/api) or the React app (web/src), then commit the regenerated bytes.
# It is intentionally NOT a prerequisite of any other target (INV-node-free-gate).
web-build:
	swag init -d internal/api -g doc.go -o internal/web/api -ot json,yaml --parseDependencyLevel 1
	mv internal/web/api/swagger.json internal/web/api/openapi.json
	mv internal/web/api/swagger.yaml internal/web/api/openapi.yaml
	cd web && npm ci && npm run build

# dev: one-command dev mode — the Go server (:8080, MELLIFERA_WEB_DEV=true) +
# the Vite dev server (:5173, which proxies /api + /openapi.* + /docs to :8080).
# Dev-only convenience (scripts/dev.sh): never part of the build gate.
dev:
	@./scripts/dev.sh
