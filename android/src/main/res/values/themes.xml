<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mellifera" parent="android:Theme.Material.NoActionBar">
        <!-- The canvas law (design §D): the window paints the web's
             #10121d — the color lives in values/colors.xml as app_canvas,
             which mirrors ui/App.kt's AppCanvas (the scheme supplies it;
             the only Compose paint is the rail panel). The window surface
             is already an opaque full-screen paint, so punch-through
             playback is untouched. -->
        <item name="android:windowBackground">@color/app_canvas</item>
    </style>
</resources>
