# Mellifera compose configuration example.
# Copy to .env (gitignored) and fill in:

# Required — the admin login token for the web UI and API.
MELLIFERA_ADMIN_TOKEN=change-me

# Recommended — HMAC secret for playback media tokens (hex). Without it the
# server generates a random per-boot secret and in-flight playback breaks on
# every container restart. Generate with: openssl rand -hex 32
MELLIFERA_MEDIA_SECRET=
