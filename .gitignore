# Mellifera — build artifacts, IDE, OS, runtime

# macOS
.DS_Store

# IDE
.idea/
*.iml

# Go build artifacts
/bin/
/base-scanner
/tv-parser
/image-enricher
/mellifera
*.exe
*.test
coverage.out
coverage.html
*.prof

# Runtime data (SQLite DBs, plugin extraction, caches)
/data/

# Local compose secrets (see .env.example)
.env

# Dev-mode artifacts (scripts/dev.sh: the dev server binary + logs)
/.tmp/

# wf source map — generated per tree by `wf index build`, never merged
/docs/.source_map.json

# Web/SPA dev (Phase 2+): npm + Vite build output
node_modules/
/web/dist/

# generated itest fixtures (frame-grabber thumbs root et al.)
internal/itest/data/

# Throwaway T0 probe (task 1.2; the tree is deleted by 5.1)
android-tvprobe/build/
android-tvprobe/app/build/
android-tvprobe/.gradle/
android-tvprobe/local.properties

# Android TV app: APK drop dir is kept, APKs are local artifacts; signing and
# IDE-local config never enter the tree
android/apk/*.apk
!android/apk/.gitkeep
android/keystore.properties
android/local.properties
